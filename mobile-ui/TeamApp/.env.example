# Expo inlines EXPO_PUBLIC_* values into the app at build/start time.
# Override these values for the target runtime; do not commit secrets here.

# Web/iOS simulator/local machine:
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Android emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1

# Physical device: use the development machine's LAN IP, for example:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8000/api/v1

# Production:
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api/v1

# Request timeout in milliseconds.
EXPO_PUBLIC_API_TIMEOUT_MS=10000
